{
  "name": "virga-workspace",
  "version": "0.1.19",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --config preview/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build --config packages/plugin/vite.config.ts",
    "pack": "pnpm run build && node tools/package.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run pack",
    "test:browser": "pnpm run build && node tests/browser.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "fflate": "0.8.3",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2",
    "playwright-core": "1.65.1"
  }
}
